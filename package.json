{
  "name": "restfuldb",
  "version": "1.0.0",
  "description": "Automatically expose PostgreSQL databases as RESTful APIs with full CRUD, RLS, and auto-generated Swagger docs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "RESTFULDB_LOG_PRETTY=true tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src/ --ext .ts",
    "test": "jest",
    "migrate": "psql $DATABASE_URL -f scripts/migrations/001_audit_log.sql && psql $DATABASE_URL -f scripts/migrations/002_views_example.sql"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0",
    "pino": "^8.21.0",
    "pino-http": "^10.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/pg": "^8.11.10",
    "@types/swagger-ui-express": "^4.1.7",
    "@types/uuid": "^9.0.8",
    "pino-pretty": "^11.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2"
  }
}
