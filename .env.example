RESTFULDB_PORT=3000

# Database
RESTFULDB_DB_HOST=localhost
RESTFULDB_DB_PORT=5432
RESTFULDB_DB_NAME=mydb
RESTFULDB_DB_USER=postgres
RESTFULDB_DB_PASSWORD=postgres
RESTFULDB_DB_POOL_MIN=2
RESTFULDB_DB_POOL_MAX=10
RESTFULDB_DB_SSL=false

# Schemas to expose (comma-separated)
RESTFULDB_SCHEMAS=public

# Auth
RESTFULDB_AUTH_ENABLED=true
RESTFULDB_JWT_SECRET=your-secret-key
RESTFULDB_JWT_ALGORITHM=HS256
RESTFULDB_JWT_ROLE_CLAIM=role
RESTFULDB_ANON_ROLE=anon

# Introspection
RESTFULDB_INTROSPECTION_INTERVAL_MS=60000
RESTFULDB_EXCLUDE_TABLES=

# Pagination
RESTFULDB_DEFAULT_LIMIT=50
RESTFULDB_MAX_LIMIT=1000

# CORS
RESTFULDB_CORS_ORIGINS=*
RESTFULDB_CORS_CREDENTIALS=true
